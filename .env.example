# Configuration Immo Colucci
# Copier ce fichier en .env et adapter les valeurs

# Environnement
APP_ENV=development
APP_DEBUG=0

# URL du site (sans slash final)
SITE_URL=http://localhost:8080/immocolucci_dynamique

# Base de données MySQL
DB_HOST=127.0.0.1
DB_NAME=immocolucci
DB_USER=root
DB_PASS=

# API OpenAI (optionnel, pour le chatbot)
OPENAI_API_KEY=